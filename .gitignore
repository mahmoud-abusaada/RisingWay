# =============================================================================
# Rising Way - Unity 2021.3.18f1
# Baseline established at ticket P0-01.
# =============================================================================

# -----------------------------------------------------------------------------
# Unity generated / derived caches - all regenerable, never commit
# -----------------------------------------------------------------------------
[Ll]ibrary/
[Ll]ibrary2/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/

# Unity Recorder output - local captures, not project source
[Rr]ecordings/

# Unity Editor scratch
.utmp/
sysinfo.txt
*.stackdump

# Never ignore .meta files for assets we do track
!/[Aa]ssets/**/*.meta

# -----------------------------------------------------------------------------
# External Dependency Manager (EDM4U) working directories
# Regenerated by Assets > External Dependency Manager > Android Resolver
# -----------------------------------------------------------------------------
/PlayServicesResolverGradle/

# -----------------------------------------------------------------------------
# IDE / toolchain
# Note: the *.csproj files in this repo root are stale leftovers referencing
# packages no longer present (Toony Colors Pro, KinoBloom). Regenerated by Unity.
# -----------------------------------------------------------------------------
.vs/
.idea/
.consulo/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
/[Aa]ssets/Plugins/Editor/JetBrains*

# -----------------------------------------------------------------------------
# Build artefacts
# The last shipped AAB (124 MB) and APK (123 MB) live under Builds/ and are
# archived out of the tree in ticket P0-05. The ProGuard mapping file is kept
# outside the repo - it is the only way to symbolicate crashes from the
# last released build (v1.0.19 / versionCode 20).
# -----------------------------------------------------------------------------
*.apk
*.aab
*.ipa
*.app
*.unitypackage
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/
crashlytics-build.properties

# -----------------------------------------------------------------------------
# SIGNING MATERIAL - NEVER COMMIT
#
# Four keystores currently sit in this project. Ticket P0-02 determines which
# one signed the published Play build. They are excluded here so they can never
# reach a remote, but that means git is NOT backing them up.
#
#   >> These files must be backed up somewhere secure and off this machine. <<
#   >> Losing them may make the existing Play listing unupdatable forever.  <<
#
# Store them in a password manager or encrypted vault alongside their passwords,
# not in this repository.
# -----------------------------------------------------------------------------
*.keystore
*.jks
*.p12
*.pepk
*.mobileprovision
*.cer
*.certSigningRequest
/KeyStore/

# -----------------------------------------------------------------------------
# Local secrets / config that should not be shared
# -----------------------------------------------------------------------------
*.local
.env
.env.*

# -----------------------------------------------------------------------------
# OS noise
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini

# -----------------------------------------------------------------------------
# Generated by com.unity.test-framework.performance on every build. Lives under
# Resources/, so it would ship in the app unconditionally and embeds the whole
# package manifest. Regenerated each build - see P4-10 for removing it from builds.
# -----------------------------------------------------------------------------
/Assets/Resources/PerformanceTestRunInfo.json
/Assets/Resources/PerformanceTestRunInfo.json.meta
/Assets/Resources/PerformanceTestRunSettings.json
/Assets/Resources/PerformanceTestRunSettings.json.meta

# Unity 6 build profiles: created by the Build window, not used by RisingWayBuilder.
/Assets/Settings/
/Assets/Settings.meta

# Python bytecode from the Tools/ scripts
__pycache__/
