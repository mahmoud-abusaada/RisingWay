# -----------------------------------------------------------------------------
# Windows / host executables shipped by editor tooling (Firebase EDM helpers)
# Added as a P0-01 follow-up: these were committed as plain blobs on first pass.
# -----------------------------------------------------------------------------
*.exe   filter=lfs diff=lfs merge=lfs -text
*.msi   filter=lfs diff=lfs merge=lfs -text
*.bin   filter=lfs diff=lfs merge=lfs -text

# -----------------------------------------------------------------------------
# Uppercase extension variants. Git attribute matching is case-sensitive, and
# asset-store packages ship mixed-case extensions (Assets/Fonts/HaloFont.TTF was
# committed as a plain blob on the first pass because it did not match *.ttf).
# -----------------------------------------------------------------------------
*.TTF   filter=lfs diff=lfs merge=lfs -text
*.OTF   filter=lfs diff=lfs merge=lfs -text
*.TGA   filter=lfs diff=lfs merge=lfs -text
*.PSD   filter=lfs diff=lfs merge=lfs -text
*.WAV   filter=lfs diff=lfs merge=lfs -text
*.MP3   filter=lfs diff=lfs merge=lfs -text
